<?xml version="1.0" encoding="utf-8"?>
<!-- Two package sources, the same on every machine and on CI. <clear /> drops
     sources configured on the machine (for example the local feeds of the 8005
     v2 line on vm01). The source mapping sends RIoT.Sdk.* to GitHub Packages
     only and everything else to nuget.org only, so neither source can supply a
     package meant to come from the other (docs/adr/0028-riot-sdk-from-github-packages.md).

     GitHub Packages needs a token even to read. None is stored here: CI passes
     its GITHUB_TOKEN in the environment variable
     NuGetPackageSourceCredentials_github, and a developer stores a read:packages
     token once in the user-level NuGet configuration under the source name
     "github" (README, "第一次还原之前"). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/trytoreachpeak0/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="RIoT.Sdk.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
