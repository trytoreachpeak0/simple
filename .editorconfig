# Formatting only. Analyzer severities come from AnalysisLevel in
# Directory.Build.props; this file sets no dotnet_diagnostic.* severity and
# no code-style option with a ":severity" suffix, so it never changes which
# rules break the build.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown uses two trailing spaces as a line break.
[*.md]
trim_trailing_whitespace = false

[*.{json,csproj,props,targets,slnx,xml,yml,yaml}]
indent_size = 2

[*.cs]
# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces and new lines (Allman, the .NET default)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Namespaces
csharp_style_namespace_declarations = file_scoped
