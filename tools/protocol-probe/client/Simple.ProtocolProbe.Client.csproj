<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway probe for #18: the onboard side. Windows only, because the
       terminal key lives in a CNG key container (software or TPM) and its
       certificate in the CurrentUser\My store. Published self-contained for
       win-x64; not part of the product. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>simple-probe-client</AssemblyName>
    <RootNamespace>Simple.ProtocolProbe.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\probe_v1.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
