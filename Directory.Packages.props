<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- A PackageVersion below also pins that package where it arrives
         transitively, so a vulnerable transitive version can be raised here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Server ↔ onboard terminal protocol (ADR 0025): gRPC on Kestrel,
         contracts generated from .proto files in Simple.Protocol. -->
    <!-- Modbus TCP: the IO simulator's server and the onboard terminal's client
         (issue #70), one library at both ends. -->
    <PackageVersion Include="FluentModbus" Version="5.3.2" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.84.0" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <!-- The keys behind the login cookie live in the server's database (ADR 0045). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- The version EF Core SQL Server brings to Simple.Server, so the server
         and the command line use one SQL client. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363" />
    <!-- Scenario files (issue #79): validated against scenarios/scenario.schema.json
         by the command line. MIT; JsonSchema.Net was passed over for its
         maintenance-fee terms on the binary packages. -->
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <!-- Retries with backoff and jitter (ADR 0008): the MES gateway's rounds, the server's polling of the gateway and the onboard terminal's reconnects. -->
    <!-- The MES gateway's real source (issue #93): Oracle's managed driver in Thin
         mode, no Oracle client installed. The version the previous line read the
         same customer MES with in production. -->
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.9.0" />
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <!-- Shortest paths on the fake fleet manager's directed route graph (Simple.FakeRiot). -->
    <PackageVersion Include="QuikGraph" Version="2.5.0" />
    <!-- From trytoreachpeak0/riot-sdk on GitHub Packages (nuget.config, ADR 0028).
         Brings RIoT.Sdk.Core and RIoT.Sdk.Generated at the same version. -->
    <PackageVersion Include="RIoT.Sdk.Facade" Version="0.3.1" />
    <!-- Program logs (ADR 0034, issue #54): Serilog behind Microsoft.Extensions.Logging,
         size-limited local files; Simple.Logging. -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- Transitive via Microsoft.Data.SqlClient 6.1.7 (EF Core SQL Server), which
         asks for 9.0.11: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Scenario and site files are YAML (issue #79), read by the command line. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- xunit.v3 4.x depends on xunit.v3.mtp-v2: Microsoft Testing Platform v2. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
