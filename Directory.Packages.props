<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- A PackageVersion below also pins that package where it arrives
         transitively, so a vulnerable transitive version can be raised here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- The version EF Core SQL Server brings to Simple.Server, so the server
         and the command line use one SQL client. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.363" />
    <!-- Retries with backoff and jitter (ADR 0008): the MES gateway's rounds and the server's polling of the gateway. -->
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- Transitive via Microsoft.Data.SqlClient 6.1.7 (EF Core SQL Server), which
         asks for 9.0.11: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- xunit.v3 4.x depends on xunit.v3.mtp-v2: Microsoft Testing Platform v2. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
