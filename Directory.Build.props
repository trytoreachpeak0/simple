<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- On CI (GitHub Actions sets CI=true) restore must match the committed
       packages.lock.json exactly: a dependency change without its lock file
       fails restore with NU1004 instead of silently resolving anew.
       NU1900 says only that NuGet's audit could not read the vulnerability
       data (nuget.org unreachable from CI, run 39062968120), not that a
       package is vulnerable, so on CI it stays a warning. A vulnerability
       found (NU1901-NU1904) still fails restore there, as warnings as errors
       make it everywhere (tests/Simple.Cli.Tests/NuGetAuditTests.cs). -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Test projects run on Microsoft Testing Platform v2 (xunit.v3 4.x), which
       builds each test project as its own executable. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
