<Project Sdk="Microsoft.NET.Sdk">

  <!-- The onboard terminal without a window, for the local system, tests and
       CI. ASP.NET Core only serves the test input, which listens only in test
       mode and only on loopback. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Simple.OnboardTerminal.Core\Simple.OnboardTerminal.Core.csproj" />
  </ItemGroup>

</Project>
