<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>simple</AssemblyName>
    <RootNamespace>Simple.Cli</RootNamespace>
    <!-- CsWin32 generates the Win32 declarations used to start and stop child processes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads the components' program logs in the order they were written (simple logs). -->
    <ProjectReference Include="..\Simple.Logging\Simple.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The remote side of simple remote, copied to the remote machine when it lacks this version. -->
    <EmbeddedResource Include="Remote/agent.ps1" LogicalName="Simple.Cli.Remote.agent.ps1" />
    <!-- The scenario format, kept beside the scenarios so editors find it. -->
    <EmbeddedResource Include="../../scenarios/scenario.schema.json" LogicalName="Simple.Cli.Scenarios.scenario.schema.json" Link="Scenarios/scenario.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Simple.Cli.Tests" />
  </ItemGroup>

</Project>
